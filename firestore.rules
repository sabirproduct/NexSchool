rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && role() == 'super_admin';
    }

    match /students/{studentId} {
      allow read: if signedIn() && (
        role() in ['super_admin','school_admin','principal','teacher'] ||
        (role() == 'student' && request.auth.uid == resource.data.userId)
      );
      allow write: if signedIn() && role() in ['super_admin','school_admin'];
    }

    match /{document=**} {
      allow read, write: if signedIn() && role() == 'super_admin';
    }
  }
}
