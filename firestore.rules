rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Check if user exists in users collection
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Check user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Admin roles that can perform write/delete operations
    function isAdmin() {
      return userExists() && getUserRole() in ['super_admin','school_admin','principal'];
    }

    // Higher-level admin roles (super_admin only for critical system operations)
    function isSuperAdmin() {
      return userExists() && getUserRole() == 'super_admin';
    }

    // Any authenticated user with a Firestore user doc
    function isAuthenticatedUser() {
      return signedIn() && userExists();
    }

    match /students/{studentId} {
      allow create: if true;
      allow read: if isAuthenticatedUser();
      allow update: if isAuthenticatedUser();
      allow delete: if isAdmin();
    }

    match /parents/{parentId} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }
    match /sections/{id} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }
    match /hostels/{id} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }
    match /subjects/{id} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }
    match /academicSessions/{id} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }

    match /admissionApplications/{applicationId} {
      allow create: if true;
      allow read, update: if isAuthenticatedUser();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if isAdmin();
      allow read: if isAuthenticatedUser();
      allow update, delete: if isAdmin();
    }

    match /studentAttendance/{attendanceId} {
      allow read: if isAuthenticatedUser();
      allow create, update: if isAuthenticatedUser();
      allow delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAuthenticatedUser();
      allow create, update, delete: if isAdmin();
    }

    match /marks/{markId} {
      allow read: if isAuthenticatedUser();
      allow create, update: if isAuthenticatedUser();
      allow delete: if isAdmin();
    }

    match /gradeRules/{ruleId} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }

    match /timetables/{timetableId} {
      allow read: if isAuthenticatedUser();
      allow create, update, delete: if isAdmin();
    }

    // ========== SYSTEM CONFIG ==========
    match /systemRoles/{roleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      // Allow access to own user document or any user if admin
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Allow a user to create/update their own document (needed during user creation flow
      // where createUserWithEmailAndPassword signs in the new user temporarily),
      // or admins to create/update any user doc
      allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Fees collection
    match /fees/{feeId} {
      allow read: if isAuthenticatedUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Everything else
    match /{document=**} {
      allow read: if isAuthenticatedUser();
      allow write: if isAdmin();
    }
  }
}