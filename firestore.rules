rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return userDoc().role; }
    function isAdmin() { return role() in ['super_admin','school_admin','principal']; }

    match /students/{studentId} {
      allow create, update, delete: if signedIn() && isAdmin();
      allow read: if signedIn() && (
        isAdmin() ||
        (role() == 'teacher' && resource.data.classId in userDoc().assignedClassIds) ||
        (role() == 'student' && resource.data.userId == request.auth.uid) ||
        (role() == 'parent' && studentId in userDoc().studentIds) ||
        (role() == 'accountant')
      );
    }

    match /parents/{parentId} {
      allow read, write: if signedIn() && isAdmin();
    }

    match /studentDocuments/{docId} {
      allow read: if signedIn() && (isAdmin() || role() in ['teacher','student','parent']);
      allow write: if signedIn() && isAdmin();
    }

    match /studentPromotions/{promotionId} {
      allow read: if signedIn();
      allow write: if signedIn() && isAdmin();
    }

    match /classes/{id} { allow read: if signedIn(); allow write: if signedIn() && isAdmin(); }
    match /sections/{id} { allow read: if signedIn(); allow write: if signedIn() && isAdmin(); }
    match /hostels/{id} { allow read: if signedIn(); allow write: if signedIn() && isAdmin(); }
    match /admissionApplications/{applicationId} {
      allow create: if true;
      allow read: if signedIn() && isAdmin();
      allow update: if signedIn() && isAdmin();
      allow delete: if signedIn() && role() == 'super_admin';
    }
    match /admissionEnquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if signedIn() && isAdmin();
    }
    match /admissionReviews/{reviewId} {
      allow read, write: if signedIn() && isAdmin();
    }
    match /admissionDocuments/{documentId} {
      allow create: if true;
      allow read, update, delete: if signedIn() && isAdmin();
    }
    match /admissionFees/{feeId} {
      allow read, write: if signedIn() && isAdmin();
    }
    match /notifications/{notificationId} {
      allow create: if signedIn() && isAdmin();
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if signedIn() && isAdmin();
    }


    match /studentAttendance/{attendanceId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (role() == 'teacher' && resource.data.classId in userDoc().assignedClassIds) ||
        (role() == 'student' && resource.data.studentId == request.auth.uid) ||
        (role() == 'parent' && resource.data.studentId in userDoc().studentIds)
      );
      allow create, update: if signedIn() && (isAdmin() || role() == 'teacher');
      allow delete: if signedIn() && isAdmin();
    }

    match /teacherAttendance/{attendanceId} {
      allow read: if signedIn() && (isAdmin() || role() in ['teacher','accountant']);
      allow write: if signedIn() && isAdmin();
    }

    match /hostelAttendance/{recordId} {
      allow read: if signedIn() && (isAdmin() || role() in ['hostel_warden','teacher']);
      allow write: if signedIn() && (isAdmin() || role() == 'hostel_warden');
    }

    match /attendanceSummary/{studentId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == studentId || studentId in userDoc().studentIds || role() == 'teacher');
      allow write: if signedIn() && isAdmin();
    }

    match /attendanceLogs/{logId} { allow read, write: if signedIn() && isAdmin(); }
    match /leaveApplications/{leaveId} { allow read: if signedIn(); allow write: if signedIn(); }
    match /attendanceSettings/{settingId} { allow read: if signedIn(); allow write: if signedIn() && isAdmin(); }

    match /{document=**} { allow read, write: if signedIn() && role() == 'super_admin'; }
  }
}
